# ============================================================
# Environment Variables Configuration Template
# (Copy this to .env and fill in your actual credentials)
# ============================================================

# Gemini API Keys (comma-separated for resilient rotation)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# PostgreSQL / Supabase pgvector Database Credentials
DB_HOST=your-db-host.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_database_password
